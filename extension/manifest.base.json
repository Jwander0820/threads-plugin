{
  "manifest_version": 3,
  "name": "Threads Plugin",
  "description": "Download Threads media and copy post text or clean links with explicit privacy controls.",
  "minimum_chrome_version": "111",
  "action": {
    "default_title": "Threads Plugin settings",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "background": {
    "service_worker": "service-worker.js"
  },
  "options_page": "options.html"
}
